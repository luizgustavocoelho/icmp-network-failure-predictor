# ============================================================
# DATABASE
# ============================================================

# Production / cloud:
# When DATABASE_URL is defined, it takes precedence over
# the local DB_* variables below.
#
# Example only. Never commit real credentials.
#
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require


# Local development fallback

DB_HOST=localhost
DB_PORT=5433
DB_NAME=icmp_network_predictor
DB_USER=postgres
DB_PASSWORD=your_password


# ============================================================
# AUTHENTICATION
# ============================================================

AUTH_JWT_SECRET=replace_with_a_secure_random_secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============================================================
# AUTOMATIC MONITORING
# ============================================================

AUTO_MONITOR_ENABLED=false
AUTO_MONITOR_INTERVAL_SECONDS=60
AUTO_MONITOR_PING_COUNT=4
AUTO_MONITOR_TIMEOUT_MS=1000