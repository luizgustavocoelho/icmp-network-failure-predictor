{
  "expo": {
    "name": "NetPulse",
    "slug": "mobile",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/icon.png"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#071525"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luizgcoelho.icmpnetworkpredictor"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071525",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "75194f70-d322-4791-8272-604b2f7ee0b6"
      }
    }
  }
}